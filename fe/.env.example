# Leave unset in development: requests then go to /api on the Vite dev server,
# which proxies them to the backend (see vite.config.ts). Keeping them
# same-origin is what lets the httpOnly session cookie through.
#
# Set this only when the API lives on another origin, e.g. a deployed preview:
# VITE_API_URL=https://api.example.com/api
