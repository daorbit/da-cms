{
  "version": 2,
  "builds": [
    {
      "src": "be/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "fe/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "be/api/index.ts"
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "be/api/index.ts"
    },
    {
      "src": "/oauth/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "dest": "fe/assets/$1"
    },
    {
      "src": "/(.*\\.[a-zA-Z0-9]+)$",
      "dest": "fe/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "fe/index.html"
    }
  ]
}
