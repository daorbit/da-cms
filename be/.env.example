PORT=8081
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=da_cms_token

# --- Mail --------------------------------------------------------------------
# Optional locally. With SMTP_USER and SMTP_PASS unset, nothing is sent and
# verification codes are logged to the console instead — a fresh checkout signs
# up without needing a mail account.
#
# SMTP_PASS is an app password, not the account password: Gmail rejects the
# latter when two-factor auth is on. Generate one under the Google account's
# security settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=da-cms
